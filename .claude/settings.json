{
  "permissions": {
    "deny": [
      "Bash(wrangler deploy)",
      "Bash(npx wrangler deploy)",
      "Bash(wrangler versions deploy *)",
      "Bash(npx wrangler versions deploy *)",
      "Bash(wrangler secret *)",
      "Bash(npx wrangler secret *)",
      "Bash(gh secret *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(gh repo delete *)",
      "Bash(sh)",
      "Bash(bash)",
      "Bash(zsh)",
      "Bash(sudo sh *)",
      "Bash(sudo bash *)",
      "PowerShell(wrangler deploy)",
      "PowerShell(npx wrangler deploy)",
      "PowerShell(wrangler versions deploy *)",
      "PowerShell(npx wrangler versions deploy *)",
      "PowerShell(wrangler secret *)",
      "PowerShell(npx wrangler secret *)",
      "PowerShell(gh secret *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push --force-with-lease *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(Invoke-Expression *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"" }]
      }
    ]
  }
}
