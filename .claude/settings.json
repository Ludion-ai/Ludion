{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "WebFetch", "WebSearch",
      "Bash(npm *)", "Bash(npx *)", "Bash(node *)", "Bash(git *)", "Bash(gh *)",
      "Bash(python3 *)", "Bash(pip *)", "Bash(uv *)", "Bash(go *)", "Bash(docker *)", "Bash(wrangler dev *)",
      "Bash(ls *)", "Bash(cat *)", "Bash(head *)", "Bash(tail *)", "Bash(wc *)", "Bash(grep *)", "Bash(rg *)", "Bash(find *)",
      "Bash(mkdir *)", "Bash(cp *)", "Bash(mv *)", "Bash(rm *)", "Bash(touch *)", "Bash(chmod *)", "Bash(diff *)",
      "Bash(curl *)", "Bash(jq *)", "Bash(sed *)", "Bash(awk *)", "Bash(sort *)", "Bash(uniq *)",
      "Bash(tar *)", "Bash(zip *)", "Bash(unzip *)", "Bash(gzip *)", "Bash(time *)", "Bash(bash scripts/*)"
    ],
    "ask": [
      "Bash(npm publish *)", "Bash(npm unpublish *)", "Bash(npm deprecate *)", "Bash(npm owner *)", "Bash(npm access *)",
      "Bash(uv publish *)", "Bash(twine *)",
      "Bash(gh repo create *)", "Bash(gh repo edit *)", "Bash(gh repo delete *)", "Bash(gh release *)", "Bash(gh secret *)", "Bash(gh api *)",
      "Bash(wrangler deploy *)", "Bash(wrangler secret *)", "Bash(vercel *)"
    ],
    "deny": [
      "Bash(git push --force *)", "Bash(git push -f *)",
      "Read(./.env)", "Read(./.env.*)", "Read(./secrets/**)",
      "Edit(.claude/settings.json)", "Edit(.claude/settings.local.json)", "Edit(.claude/hooks/**)", "Edit(accept/ratchet.json)",
      "Edit(accept/ratchet/**)", "Write(accept/ratchet/**)", "Write(accept/ratchet.json)",
      "Bash(rm accept/ratchet*)", "Bash(rm -rf accept/ratchet*)", "Bash(git rm accept/ratchet*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact", "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.mjs\"" } ] }
    ]
  }
}
