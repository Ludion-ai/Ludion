{
  "name": "ludion",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "scripts": {
    "verify": "node tools/verify/src/cli.ts",
    "verify:pr": "node tools/verify/src/pr-cli.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/worker/tsconfig.json",
    "build": "npm run build --workspaces --if-present",
    "gen:validator": "node packages/core/scripts/gen-validator.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  }
}
