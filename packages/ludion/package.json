{
  "name": "ludion",
  "version": "0.0.1",
  "description": "Ludion: give your AI agent its own key and name (CLI), and the Gate that reads them (Node, Next.js, Cloudflare Workers). Web Bot Auth (RFC 9421) and OAuth CIMD.",
  "keywords": [
    "web-bot-auth",
    "rfc9421",
    "http-message-signatures",
    "ai-agents",
    "bot"
  ],
  "license": "Apache-2.0",
  "homepage": "https://ludion.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ludion-ai/Ludion.git",
    "directory": "packages/ludion"
  },
  "bugs": {
    "url": "https://github.com/Ludion-ai/Ludion/issues"
  },
  "type": "module",
  "bin": {
    "ludion": "bin/ludion.mjs"
  },
  "exports": {
    "./diver": "./lib/@ludion/diver/src/index.mjs",
    "./gate/node": "./lib/@ludion/gate-node/index.mjs",
    "./gate/next": "./lib/@ludion/gate-next/index.mjs",
    "./gate/next/core": "./lib/@ludion/gate-next/core.mjs",
    "./gate/workers": "./lib/@ludion/gate-workers/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node build.mjs",
    "postpack": "node build.mjs --clean"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "http-message-sig": "0.3.0",
    "jsonwebkey-thumbprint": "0.1.0",
    "web-bot-auth": "0.2.0"
  },
  "peerDependencies": {
    "next": ">=16.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
