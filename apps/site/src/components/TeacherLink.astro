---
import { siteData } from "../build/data.ts";

interface Props {
  login: string;
  id: number;
  /** Teacher page, or null when they have none. */
  href: string | null;
  size?: 24 | 40 | 64;
  showAvatar?: boolean;
}
const { login, id, href, size = 40, showAvatar = false } = Astro.props;
// By id, so the avatar survives renames.
const avatar = (await siteData()).avatarOf(id, size);
---

<span class="teacher">
  {showAvatar && <img src={avatar} alt="" width={size} height={size} decoding="async" />}
  {href ? <a href={href}>@{login}</a> : <span>@{login}</span>}
</span>

<style>
  .teacher {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  img {
    border-radius: 50%;
    background: var(--surface);
    outline: 1px solid var(--rule);
  }
</style>
