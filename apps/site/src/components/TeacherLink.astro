---
interface Props {
  login: string;
  id: number;
  /** Teacher page, or null when they have none. */
  href: string | null;
  size?: 40 | 64;
  showAvatar?: boolean;
}
const { login, id, href, size = 40, showAvatar = false } = Astro.props;
// By id, so the avatar survives renames.
const avatar = `https://avatars.githubusercontent.com/u/${id}?s=${size * 2}`;
---

<span class="teacher">
  {showAvatar && <img src={avatar} alt="" width={size} height={size} loading="lazy" decoding="async" />}
  {href ? <a href={href}>@{login}</a> : <span>@{login}</span>}
</span>

<style>
  .teacher {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  img {
    border-radius: 50%;
    background: var(--surface);
  }
</style>
