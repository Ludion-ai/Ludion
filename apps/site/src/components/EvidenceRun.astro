---
import { en } from "../strings/en.ts";

interface Props {
  runner: string;
  code: string;
}
const { runner, code } = Astro.props;
const label = runner === "lean" ? en.lesson.proof : en.lesson.test(runner);
---

<figure class="run">
  <figcaption>
    <span>{label}</span>
    <button type="button" class="copy" data-copied={en.lesson.copied}>{en.lesson.copy}</button>
  </figcaption>
  <pre tabindex="0"><code>{code}</code></pre>
</figure>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("button.copy")) {
    const original = button.textContent;
    button.addEventListener("click", async () => {
      const code = button.closest("figure")?.querySelector("code")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = button.dataset.copied ?? original;
        setTimeout(() => (button.textContent = original), 2000);
      } catch {
        // Clipboard blocked; the code is still selectable.
      }
    });
  }
</script>

<style>
  .run {
    margin: 0 0 20px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--paper-2);
    overflow: hidden;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 6px 6px 6px 16px;
    border-bottom: 1px solid var(--rule);
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
  }
  .copy {
    font: inherit;
    font-size: 13px;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 3px;
    min-height: 32px;
    padding: 0 12px;
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--ink);
  }
  pre {
    margin: 0;
    padding: 16px;
    color: var(--ink);
    overflow-x: auto;
    line-height: 1.7;
  }
</style>
