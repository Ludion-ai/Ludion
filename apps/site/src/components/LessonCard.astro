---
// Compact card for lists. The full view is the lesson page itself.
import StatusChip from "./StatusChip.astro";
import TeacherLink from "./TeacherLink.astro";
import { en, formatDate } from "../strings/en.ts";
import type { VerifiedBy } from "@ludion/core";

interface Props {
  id: string;
  claim: string;
  subject: string;
  version?: string | null;
  teacher: string;
  teacherId: number;
  teacherHref: string | null;
  verifiedBy: VerifiedBy;
  verifiedAt: string;
}
const p = Astro.props;
---

<article class="card">
  <p class="claim"><a href={`/lessons/${p.id}/`}>{p.claim}</a></p>
  <p class="meta">
    <StatusChip status="verified" label={en.lesson.verifiedBy[p.verifiedBy]} />
    <TeacherLink login={p.teacher} id={p.teacherId} href={p.teacherHref} />
    <span class="muted">{en.lesson.appliesTo(p.subject, p.version)}</span>
    <time class="muted" datetime={p.verifiedAt}>{formatDate(p.verifiedAt)}</time>
  </p>
</article>

<style>
  .card {
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  .claim {
    margin: 0 0 8px;
    color: var(--ink);
  }
  .claim a {
    color: inherit;
    text-decoration: none;
  }
  .claim a:hover {
    color: var(--cobalt);
    text-decoration: underline;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin: 0;
    font-size: 15px;
  }
</style>
