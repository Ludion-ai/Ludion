---
// A register entry. Compact: one ruled row with the claim and a one-line record.
// Full: the claim large beside its full record (used for the newest lesson on the home page).
import StatusChip from "./StatusChip.astro";
import TeacherLink from "./TeacherLink.astro";
import LessonRecord from "./LessonRecord.astro";
import { en, formatDate } from "../strings/en.ts";
import type { VerifiedBy } from "@ludion/core";

interface Props {
  variant?: "compact" | "full";
  id: string;
  claim: string;
  subject: string;
  version?: string | null;
  teacher: string;
  teacherId: number;
  teacherHref: string | null;
  verifiedBy: VerifiedBy;
  verifiedAt: string;
  /** Heading level for the claim in the full variant. */
  level?: 2 | 3;
  /** Leave out the teacher, on that teacher's own page. */
  hideTeacher?: boolean;
}
const { variant = "compact", level = 2, hideTeacher = false, ...p } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
---

{
  variant === "full" ? (
    <article class="full">
      <Heading class="claim big">
        <a href={`/lessons/${p.id}/`}>{p.claim}</a>
      </Heading>
      <div class="rail">
        <LessonRecord
          verifiedBy={p.verifiedBy}
          verifiedAt={p.verifiedAt}
          subject={p.subject}
          version={p.version}
          teacher={p.teacher}
          teacherId={p.teacherId}
          teacherHref={p.teacherHref}
        />
      </div>
    </article>
  ) : (
    <article class="row">
      <p class="claim">
        <a href={`/lessons/${p.id}/`}>{p.claim}</a>
      </p>
      <p class="meta">
        <StatusChip status="verified" label={en.lesson.verifiedBy[p.verifiedBy]} />
        {!hideTeacher && <TeacherLink login={p.teacher} id={p.teacherId} href={p.teacherHref} />}
        <span>{en.lesson.appliesTo(p.subject, p.version)}</span>
        <time datetime={p.verifiedAt}>{formatDate(p.verifiedAt)}</time>
      </p>
    </article>
  )
}

<style>
  .row {
    padding: var(--space-5) 0;
  }
  .row .claim {
    font-size: var(--size-claim);
    line-height: 1.45;
    margin: 0 0 var(--space-3);
    max-width: 44em;
  }
  .claim a {
    color: inherit;
    text-decoration: none;
  }
  .claim a:hover {
    text-decoration: underline;
    text-decoration-color: var(--rule);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    font-size: var(--size-meta);
    color: var(--muted);
  }

  .full {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--rail);
    gap: var(--space-8);
    align-items: start;
  }
  .big {
    font-size: var(--size-hero);
    line-height: 1.25;
    margin: 0;
    max-width: 22em;
  }
  .rail {
    padding-top: var(--space-2);
    border-left: 1px solid var(--rule);
    padding-left: var(--space-5);
  }
  @media (max-width: 860px) {
    .full {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .rail {
      border-left: 0;
      padding-left: 0;
      padding-top: 0;
    }
  }
</style>
