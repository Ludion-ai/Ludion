---
// The record that travels with every claim: how and when it was verified, where it applies, who taught it,
// and where to check. Lines, not labels: each line already says what it is.
import StatusChip from "./StatusChip.astro";
import TeacherLink from "./TeacherLink.astro";
import { en, formatDate } from "../strings/en.ts";
import type { VerifiedBy } from "@ludion/core";

interface Props {
  verifiedBy: VerifiedBy;
  verifiedAt: string;
  subject: string;
  version?: string | null;
  teacher: string;
  teacherId: number;
  teacherHref: string | null;
  fileUrl?: string;
  prUrl?: string | null;
  pr?: number | null;
}
const p = Astro.props;
---

<dl class="record">
  <div class="verified">
    <dt class="visually-hidden">{en.record.verified}</dt>
    <dd>
      <StatusChip status="verified" label={en.lesson.verifiedBy[p.verifiedBy]} />
      <time datetime={p.verifiedAt}>{en.lesson.on(formatDate(p.verifiedAt))}</time>
    </dd>
  </div>
  <div>
    <dt class="visually-hidden">{en.record.appliesTo}</dt>
    <dd>{en.lesson.appliesTo(p.subject, p.version)}</dd>
  </div>
  <div>
    <dt class="visually-hidden">{en.record.teacher}</dt>
    <dd class="teacher">
      {en.lesson.taughtBy}
      <TeacherLink login={p.teacher} id={p.teacherId} href={p.teacherHref} showAvatar size={24} />
    </dd>
  </div>
  {
    p.fileUrl && (
      <div class="check">
        <dt class="visually-hidden">{en.record.check}</dt>
        <dd>
          <a href={p.fileUrl}>{en.lesson.viewFile}</a>
          {p.prUrl && p.pr != null && <a href={p.prUrl}>{en.lesson.pullRequest(p.pr)}</a>}
        </dd>
      </div>
    )
  }
</dl>

<style>
  .record {
    margin: 0;
    font-size: var(--size-meta);
    color: var(--text);
  }
  .record > div + div {
    margin-top: var(--space-3);
  }
  dd {
    margin: 0;
  }
  .verified dd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .teacher {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .check dd {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
