---
import { en } from "../strings/en.ts";

interface Props {
  url: string;
  quote: string;
}
const { url, quote } = Astro.props;
const host = new URL(url).host;
---

<figure class="source">
  <figcaption>{en.lesson.source}</figcaption>
  <blockquote cite={url}>
    <p class="claim">{quote}</p>
  </blockquote>
  <p class="where"><a href={url} rel="noopener nofollow">{host}</a></p>
</figure>

<style>
  .source {
    margin: 0 0 24px;
    padding: 16px 18px;
    border: 1px solid var(--panel-line);
    border-radius: 12px;
    background: var(--panel);
  }
  figcaption {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 10px;
  }
  blockquote {
    margin: 0;
  }
  blockquote p {
    margin: 0;
    font-style: italic;
    font-size: 21px;
    line-height: 1.4;
  }
  .where {
    margin: 10px 0 0;
    font-size: 14px;
    font-weight: 500;
  }
</style>
