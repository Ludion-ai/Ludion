---
// A subject: a squared label, never the seal's pill shape.
interface Props {
  subject: string;
  version?: string | null;
}
const { subject, version } = Astro.props;
---

<span class="tag"><span class="subject">{subject}</span>{version && <span class="version">{version}</span>}</span>

<style>
  .tag {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--panel-line);
    border-radius: 4px;
    font-size: 13px;
    line-height: 22px;
    color: var(--text);
    overflow: hidden;
  }
  .subject {
    padding: 0 8px;
    font-weight: 600;
  }
  .version {
    padding: 0 8px;
    border-left: 1px solid var(--panel-line);
    font-family: var(--font-code);
    font-size: 12px;
    color: var(--muted);
  }
</style>
