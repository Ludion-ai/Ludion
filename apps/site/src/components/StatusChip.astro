---
// The seal. "verified" is the brightest thing on any page: filled, lit from above (a sheen on its top edge)
// and glowing like something that has just broken the surface. "checking" is the same shape, still below:
// outlined, dim, no light. Subject tags never use this shape.
interface Props {
  status: "verified" | "checking" | "failed" | "closed";
  label: string;
  size?: "small" | "large";
}
const { status, label, size = "small" } = Astro.props;
---

<span class:list={["seal", status, size]}>
  <svg class="mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M3.5 8.4l2.9 2.9 6.1-6.6" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span>{label}</span>
</span>

<style>
  .seal {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 30px;
    padding: 0 14px 0 11px;
    border-radius: 999px;
    border: 1px solid transparent;
    font-family: var(--font-ui);
    font-size: 13.5px;
    font-weight: 650;
    letter-spacing: 0.005em;
    white-space: nowrap;
  }
  .large {
    height: 38px;
    padding: 0 18px 0 14px;
    font-size: 15px;
    gap: 9px;
  }
  .mark {
    width: 14px;
    height: 14px;
    flex: none;
  }
  .large .mark {
    width: 17px;
    height: 17px;
  }
  .verified {
    background: var(--seal-bg);
    color: var(--seal-fg);
    box-shadow:
      inset 0 1px 0 var(--seal-sheen),
      0 0 0 4px var(--seal-ring),
      0 10px 28px -10px var(--seal-glow);
  }
  .checking {
    background: var(--checking-bg);
    color: var(--checking-fg);
    border-color: var(--checking-line);
    border-style: dashed;
  }
  .failed,
  .closed {
    background: var(--failed-bg);
    color: var(--failed-fg);
    border-color: var(--failed-line);
  }
  .checking .mark,
  .failed .mark,
  .closed .mark {
    display: none;
  }
</style>
