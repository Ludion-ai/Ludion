---
import "../styles/global.css";
import Wordmark from "../components/Wordmark.astro";
import { siteData } from "../build/data.ts";
import { en } from "../strings/en.ts";

interface Props {
  title: string;
  description?: string;
  /** False for pages without a URL of their own (404). */
  canonical?: boolean;
  /** The public path when it differs from the built one (teacher pages are linked as /@<login>). */
  canonicalPath?: string;
}
const { title, description = en.site.description, canonical = true, canonicalPath } = Astro.props;
const { index, config } = await siteData();
const teacherCount = Object.keys(index.teachers).length;
// The trailing-slash URL: the one without it only redirects (307).
const path = canonicalPath ?? (Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`);
const canonicalUrl = new URL(path, config.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="home" href="/" aria-label={en.site.name}><Wordmark /></a>
        <nav aria-label={en.nav.label}>
          <a href="/lessons/" aria-current={Astro.url.pathname.startsWith("/lessons") ? "page" : undefined}>{en.nav.lessons}</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <p>{en.footer.count(index.lessons.length, teacherCount)}</p>
        <p>
          {en.footer.license} <a href={`https://github.com/${config.org}/${config.repo}`}>{en.footer.github}</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    min-height: 64px;
  }
  .home {
    display: inline-flex;
    padding: 6px 0;
    text-decoration: none;
  }
  nav a {
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    padding: 8px 0;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-top: 56px;
  }
  main > :global(:last-child) {
    padding-bottom: 96px;
  }
  .site-footer {
    border-top: 1px solid var(--rule);
    font-size: 14px;
    color: var(--muted);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 32px;
    padding-block: 24px 32px;
  }
  .foot p {
    margin: 0;
  }
  .foot a {
    color: var(--ink);
  }
</style>
