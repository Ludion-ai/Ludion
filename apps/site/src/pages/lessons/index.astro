---
import Base from "../../layouts/Base.astro";
import LessonCard from "../../components/LessonCard.astro";
import { siteData } from "../../build/data.ts";
import { en } from "../../strings/en.ts";

const STATIC_LIMIT = 100;
const { index, teacherHref } = await siteData();
const shown = index.lessons.slice(0, STATIC_LIMIT);
---

<Base title={`${en.lessons.title} | Ludion`}>
  <div class="wrap">
  <h1>{en.lessons.title}</h1>
  <p class="count">{index.lessons.length ? en.lessons.intro(shown.length, index.lessons.length) : en.lessons.empty}</p>
  <ul class="list">
    {
      shown.map((l) => (
        <li>
          <LessonCard
            id={l.id}
            claim={l.claim}
            subject={l.subject}
            version={l.version}
            teacher={l.teacher}
            teacherId={l.teacher_id}
            teacherHref={teacherHref(l.teacher_id)}
            verifiedBy={l.verified_by}
            verifiedAt={l.verified_at}
          />
        </li>
      ))
    }
  </ul>
  </div>
</Base>

<style>
  h1 {
    font-family: var(--font-claim);
    font-variation-settings: "opsz" 72;
    font-weight: 480;
    font-size: clamp(44px, 7vw, 80px);
    letter-spacing: -0.024em;
    line-height: 1;
  }
  .count {
    margin: 14px 0 32px;
    font-size: 15px;
    color: var(--muted);
  }
</style>
