---
import Base from "../../layouts/Base.astro";
import Signature from "../../components/Signature.astro";
import SubjectTag from "../../components/SubjectTag.astro";
import EvidenceRun from "../../components/EvidenceRun.astro";
import EvidenceSource from "../../components/EvidenceSource.astro";
import { siteData, type LessonPage } from "../../build/data.ts";
import Claim from "../../components/Claim.astro";
import { claimSize } from "../../build/claim-size.ts";
import { en } from "../../strings/en.ts";

// Every lesson on main, replaced ones included: history stays visible.
export async function getStaticPaths() {
  const { pages } = await siteData();
  return pages.map((page) => ({ params: { id: page.lesson.id }, props: { page } }));
}

const { page } = Astro.props as { page: LessonPage };
const { config, teacherHref } = await siteData();
const { lesson } = page;
const repo = `https://github.com/${config.org}/${config.repo}`;
---

<Base title={`${lesson.claim} | Ludion`} description={lesson.claim}>
  {
    page.correctedBy && (
      <p class="banner wrap" role="note">
        {en.lesson.correctedBy} <a href={`/lessons/${page.correctedBy}/`}>{page.correctedBy}</a>.
      </p>
    )
  }
  <article class="lesson">
    <header class="top wrap">
      <h1 class:list={["claim", claimSize(lesson.claim)]}><Claim text={lesson.claim} /></h1>
      <Signature
        teacher={page.teacher}
        teacherId={lesson.author_id}
        teacherHref={teacherHref(lesson.author_id)}
        verifiedBy={page.verified_by}
        verifiedAt={page.verified_at}
        avatar
        size="large"
      />
      <p class="where">
        <SubjectTag subject={lesson.subject} version={lesson.version} />
        <span>{en.lesson.appliesTo(lesson.subject, lesson.version)}</span>
      </p>
    </header>

    <section class="depth" aria-labelledby="evidence">
      <div class="wrap">
      <h2 id="evidence">{en.lesson.evidence}</h2>
      {
        lesson.evidence.map((e) =>
          "run" in e ? <EvidenceRun runner={e.run.runner} code={e.run.code} /> : <EvidenceSource url={e.source.url} quote={e.source.quote} />,
        )
      }
      {
        page.corrects.length > 0 && (
          <div class="corrects">
            <h2>{en.lesson.corrects}</h2>
            <ul>
              {page.corrects.map((id) => (
                <li>
                  <a href={`/lessons/${id}/`}>{id}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <p class="links">
        <a href={`${repo}/blob/main/lessons/${lesson.subject}/${lesson.id}.json`}>{en.lesson.viewFile}</a>
        {page.pr !== null && <a href={`${repo}/pull/${page.pr}`}>{en.lesson.pullRequest(page.pr)}</a>}
      </p>
      </div>
    </section>
  </article>
</Base>

<style>
  .lesson {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-bottom: 0 !important;
  }
  .top {
    padding-block: 8px 56px;
  }
  h1 {
    line-height: 1.1;
    letter-spacing: -0.016em;
    max-width: 22em;
    margin-bottom: 30px;
  }
  h1.xl { font-size: clamp(36px, 5.6vw, 68px); }
  h1.l { font-size: clamp(30px, 4.4vw, 52px); }
  h1.m { font-size: clamp(26px, 3.4vw, 40px); line-height: 1.16; }
  h1.s { font-size: clamp(22px, 2.6vw, 31px); line-height: 1.26; max-width: 34em; }
  .where {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin: 20px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  /* The evidence lies below the claim: a band of deeper water across the page, its surface lit. */
  .depth {
    flex: 1;
    position: relative;
    padding-block: 48px 72px;
    background: linear-gradient(180deg, var(--bottle-top), var(--bottle-deep));
  }
  .depth::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--surface);
    box-shadow: 0 0 16px 1px var(--surface-under);
  }
  .depth h2 {
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .corrects {
    margin-top: 8px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin: 28px 0 0;
    font-size: 15px;
    font-weight: 500;
  }
  .banner {
    display: block;
    margin-block: 0 32px;
    padding-block: 12px;
    color: var(--checking-fg);
    border-bottom: 1px dashed var(--checking-line);
  }
  .banner a {
    color: inherit;
  }
</style>