---
import Base from "../../layouts/Base.astro";
import LessonRecord from "../../components/LessonRecord.astro";
import EvidenceRun from "../../components/EvidenceRun.astro";
import EvidenceSource from "../../components/EvidenceSource.astro";
import { siteData, type LessonPage } from "../../build/data.ts";
import { en } from "../../strings/en.ts";

// Every lesson on main, replaced ones included: history stays visible.
export async function getStaticPaths() {
  const { pages } = await siteData();
  return pages.map((page) => ({ params: { id: page.lesson.id }, props: { page } }));
}

const { page } = Astro.props as { page: LessonPage };
const { config, teacherHref } = await siteData();
const { lesson } = page;
const repo = `https://github.com/${config.org}/${config.repo}`;
---

<Base title={`${lesson.claim} | Ludion`} description={lesson.claim}>
  {
    page.correctedBy && (
      <p class="banner" role="note">
        {en.lesson.correctedBy} <a href={`/lessons/${page.correctedBy}/`}>{page.correctedBy}</a>.
      </p>
    )
  }
  <article class="lesson">
    <h1 class="claim">{lesson.claim}</h1>
    <aside class="rail" aria-label={en.record.check}>
      <LessonRecord
        verifiedBy={page.verified_by}
        verifiedAt={page.verified_at}
        subject={lesson.subject}
        version={lesson.version}
        teacher={page.teacher}
        teacherId={lesson.author_id}
        teacherHref={teacherHref(lesson.author_id)}
        fileUrl={`${repo}/blob/main/lessons/${lesson.subject}/${lesson.id}.json`}
        pr={page.pr}
        prUrl={page.pr !== null ? `${repo}/pull/${page.pr}` : null}
      />
    </aside>
    <section class="evidence" aria-labelledby="evidence">
      <h2 id="evidence">{en.lesson.evidence}</h2>
      {
        lesson.evidence.map((e) =>
          "run" in e ? <EvidenceRun runner={e.run.runner} code={e.run.code} /> : <EvidenceSource url={e.source.url} quote={e.source.quote} />,
        )
      }
      {
        page.corrects.length > 0 && (
          <>
            <h2>{en.lesson.corrects}</h2>
            <ul>
              {page.corrects.map((id) => (
                <li>
                  <a href={`/lessons/${id}/`}>{id}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </section>
  </article>
</Base>

<style>
  .lesson {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--rail);
    grid-template-areas:
      "claim rail"
      "evidence evidence";
    column-gap: var(--space-8);
    align-items: start;
  }
  h1 {
    grid-area: claim;
    font-size: var(--size-hero);
    line-height: 1.25;
    max-width: 22em;
    margin: 0 0 var(--space-7);
  }
  .rail {
    grid-area: rail;
    padding-left: var(--space-5);
    border-left: 1px solid var(--rule);
    padding-top: var(--space-2);
  }
  .evidence {
    grid-area: evidence;
    min-width: 0;
  }
  .evidence h2 {
    font-size: var(--size-meta);
    font-weight: 600;
    color: var(--muted);
    margin-bottom: var(--space-4);
  }
  .banner {
    background: var(--checking-bg);
    color: var(--checking-text);
    border: 1px solid var(--checking-line);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
    margin: 0 0 var(--space-6);
  }
  .banner a {
    color: inherit;
  }
  @media (max-width: 860px) {
    .lesson {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "claim" "rail" "evidence";
    }
    h1 {
      margin-bottom: var(--space-5);
    }
    .rail {
      border-left: 0;
      padding: 0 0 var(--space-6);
      margin-bottom: var(--space-6);
      border-bottom: 1px solid var(--rule);
    }
  }
</style>
