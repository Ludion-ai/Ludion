---
// /teach (site.md): sign a lesson. The page is static; scripts/teach.ts decides which part to show from
// /api/session and the draft in #d= (which never reaches a server). Before Teach, the whole lesson is shown,
// claim and every piece of evidence in full, with the name it will be signed as.
import Base from "../layouts/Base.astro";
import { en } from "../strings/en.ts";
const t = en.teach;
---

<Base title={`${t.title} | Ludion`}>
  <div class="wrap teach">
    <h1>{t.h1}</h1>
    <p class="intro">{t.intro}</p>

    <p id="teach-error" class="error" role="alert" hidden></p>
    <p id="teach-closed" class="closed" hidden>{t.closed}</p>

    <div id="teach-signin" hidden>
      <p id="teach-sources-later" hidden>{t.sourcesAfterSignIn}</p>
      <a id="teach-signin-link" class="button primary" href="/auth/login?next=/teach">{t.signIn}</a>
    </div>

    <section id="teach-draft" class="draft" aria-labelledby="teach-draft-heading" hidden>
      <h2 id="teach-draft-heading">{t.draftHeading}</h2>
      <dl class="meta">
        <div><dt>{t.subject}</dt><dd id="draft-subject"></dd></div>
        <div><dt>{t.version}</dt><dd id="draft-version"></dd></div>
      </dl>
      <h3 class="label">{t.claim}</h3>
      <p id="draft-claim" class="claim"></p>
      <h3 class="label">{t.evidence}</h3>
      <div id="draft-evidence"></div>
    </section>

    <section id="teach-sign" class="sign" hidden>
      <p id="teach-signing-as" class="signing-as"></p>
      <p class="consent">{t.consent}</p>
      <ul id="teach-checks" class="checks"></ul>
      <div class="actions">
        <button id="teach-edit" type="button" class="button">{t.edit}</button>
        <button id="teach-check" type="button" class="button">{t.check}</button>
        <button id="teach-submit" type="button" class="button primary" disabled>{t.teach}</button>
      </div>
    </section>

    <form id="teach-form" class="form" hidden novalidate>
      <h2>{t.form.heading}</h2>
      <label for="f-subject">{t.subject}</label>
      <input id="f-subject" name="subject" autocomplete="off" spellcheck="false" aria-describedby="f-subject-hint" />
      <p id="f-subject-hint" class="hint">{t.form.subjectHint}</p>

      <label for="f-version">{t.version}</label>
      <input id="f-version" name="version" autocomplete="off" spellcheck="false" aria-describedby="f-version-hint" />
      <p id="f-version-hint" class="hint">{t.form.versionHint}</p>

      <label for="f-claim">{t.claim}</label>
      <textarea id="f-claim" name="claim" rows="3" maxlength="400" aria-describedby="f-claim-hint f-claim-count"></textarea>
      <p class="hint"><span id="f-claim-hint">{t.form.claimHint}</span> <span id="f-claim-count">{t.form.counter(0)}</span></p>

      <div id="f-evidence"></div>
      <div class="actions">
        <button id="f-add-test" type="button" class="button">{t.form.addTest}</button>
        <button id="f-add-source" type="button" class="button">{t.form.addSource}</button>
        <button type="submit" class="button primary">{t.review}</button>
      </div>
    </form>

    <section id="teach-submitted" class="submitted" hidden aria-live="polite">
      <p id="teach-pr"></p>
      <p id="teach-pr-status"></p>
    </section>

    <p id="teach-status" class="visually-hidden" aria-live="polite"></p>
  </div>
</Base>

<script>
  import "../scripts/teach.ts";
</script>

<style>
  .teach h1 {
    font-weight: 800;
    font-size: clamp(32px, 5vw, 52px);
    letter-spacing: -0.04em;
    margin-bottom: 12px;
  }
  .intro {
    margin: 0 0 32px;
    color: var(--muted);
  }
  .closed,
  .error {
    padding: 12px 16px;
    border: 1px solid var(--ink);
    border-radius: 4px;
    color: var(--ink);
  }
  .error {
    border-width: 2px;
  }
  .draft,
  .form {
    margin-top: 32px;
  }
  h2 {
    font-size: 22px;
    margin-bottom: 16px;
  }
  .label {
    font-size: 13px;
    font-weight: 700;
    text-transform: none;
    margin: 24px 0 8px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    margin: 0;
  }
  .meta dt {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
  }
  .meta dd {
    margin: 0;
    font-family: var(--font-code);
    font-variant-ligatures: none;
  }
  #draft-claim {
    font-size: 24px;
    line-height: 1.3;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .sign {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .signing-as {
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 8px;
  }
  .consent {
    margin: 0 0 16px;
    color: var(--text);
  }
  .checks {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
  }
  .checks li {
    padding: 4px 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 16px;
  }
  .button {
    font: inherit;
    font-weight: 700;
    font-size: 15px;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--ink);
    border-radius: 4px;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
  }
  .button.primary {
    background: var(--ink);
    color: var(--paper);
  }
  .button:disabled {
    cursor: not-allowed;
    border-style: dashed;
    background: var(--paper);
    color: var(--muted);
  }
  .form label {
    display: block;
    font-weight: 700;
    color: var(--ink);
    margin-top: 20px;
  }
  .form input,
  .form textarea,
  .form :global(select) {
    font: inherit;
    width: 100%;
    margin-top: 6px;
    padding: 10px 12px;
    border: 1px solid var(--muted);
    border-radius: 4px;
    background: var(--paper);
    color: var(--ink);
  }
  .form :global(textarea.code) {
    font-family: var(--font-code);
    font-variant-ligatures: none;
    font-size: 14px;
  }
  .hint {
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  :global(.evidence-item) {
    margin-top: 24px;
    padding: 16px;
    border: 1px solid var(--rule);
    border-radius: 4px;
  }
  :global(.evidence-item legend) {
    font-weight: 700;
    color: var(--ink);
    padding: 0 4px;
  }
  :global(.draft-run),
  :global(.draft-source) {
    margin: 0 0 16px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    overflow: hidden;
  }
  :global(.draft-run figcaption),
  :global(.draft-source figcaption) {
    padding: 6px 16px;
    border-bottom: 1px solid var(--rule);
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
  }
  :global(.draft-run pre) {
    margin: 0;
    padding: 16px;
    background: var(--paper-2);
    color: var(--ink);
    overflow-x: auto;
    line-height: 1.7;
  }
  :global(.draft-source blockquote) {
    margin: 12px 16px;
    padding-left: 14px;
    border-left: 3px solid var(--ink);
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  :global(.draft-source .where) {
    margin: 0 16px 12px;
    font-family: var(--font-code);
    font-variant-ligatures: none;
    font-size: 13px;
    overflow-wrap: anywhere;
  }
</style>
