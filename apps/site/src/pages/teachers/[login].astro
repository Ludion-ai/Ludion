---
import Base from "../../layouts/Base.astro";
import LessonCard from "../../components/LessonCard.astro";
import { siteData } from "../../build/data.ts";
import { en } from "../../strings/en.ts";

// One page per teacher id, at the current login lowercased. Served at /@<login> by the Worker.
export async function getStaticPaths() {
  const { teacherPages } = await siteData();
  return [...teacherPages].map(([login, id]) => ({ params: { login }, props: { id } }));
}

const { id } = Astro.props as { id: number };
const { index, loginOf, teacherHref } = await siteData();
const login = loginOf(id);
const summary = index.teachers[String(id)]!;
const lessons = index.lessons.filter((l) => l.teacher_id === id);
---

<Base title={en.teacher.title(login)} canonicalPath={`/@${login.toLowerCase()}`}>
  <header class="teacher">
    <img src={`https://avatars.githubusercontent.com/u/${id}?s=128`} alt="" width="64" height="64" />
    <div>
      <h1>@{login}</h1>
      <p class="summary">
        {en.teacher.summary(summary.lessons, summary.subjects.length)}
        <a href={`https://github.com/${login}`}>{en.teacher.profile}</a>
      </p>
    </div>
  </header>
  <ul class="subjects" aria-label={en.teacher.subjects}>
    {summary.subjects.map((s) => <li>{s}</li>)}
  </ul>
  <ul class="register">
    {
      lessons.map((l) => (
        <li>
          <LessonCard
            id={l.id}
            claim={l.claim}
            subject={l.subject}
            version={l.version}
            teacher={l.teacher}
            teacherId={l.teacher_id}
            teacherHref={teacherHref(l.teacher_id)}
            verifiedBy={l.verified_by}
            verifiedAt={l.verified_at}
            hideTeacher
          />
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .teacher {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-bottom: var(--space-5);
  }
  .teacher img {
    border-radius: 50%;
    background: var(--surface);
    outline: 1px solid var(--rule);
    flex: none;
  }
  h1 {
    font-size: var(--size-title);
    margin: 0 0 var(--space-1);
    overflow-wrap: anywhere;
  }
  .summary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin: 0;
    font-size: var(--size-meta);
  }
  .subjects {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
  }
  .subjects li {
    font-size: var(--size-small);
    font-weight: 500;
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: var(--space-1) var(--space-3);
  }
</style>
