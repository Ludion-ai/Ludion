---
import Base from "../../layouts/Base.astro";
import LessonCard from "../../components/LessonCard.astro";
import { siteData } from "../../build/data.ts";
import { en } from "../../strings/en.ts";

// One page per teacher id, at the current login lowercased. Served at /@<login> by the Worker.
export async function getStaticPaths() {
  const { teacherPages } = await siteData();
  return [...teacherPages].map(([login, id]) => ({ params: { login }, props: { id } }));
}

const { id } = Astro.props as { id: number };
const { index, loginOf, teacherHref, avatarOf } = await siteData();
const login = loginOf(id);
const summary = index.teachers[String(id)]!;
const lessons = index.lessons.filter((l) => l.teacher_id === id);
---

<Base title={en.teacher.title(login)} canonicalPath={`/@${login.toLowerCase()}`}>
  <div class="wrap">
    <header class="teacher">
      <img src={avatarOf(id, 64)} alt="" width="72" height="72" />
      <div>
        <h1>@{login}</h1>
        <p class="summary">
          <span>{en.teacher.summary(summary.lessons, summary.subjects.length)}</span>
          <a href={`https://github.com/${login}`}>{en.teacher.profile}</a>
        </p>
      </div>
    </header>
    <ul class="list">
      {
        lessons.map((l) => (
          <li>
            <LessonCard
              id={l.id}
              claim={l.claim}
              subject={l.subject}
              version={l.version}
              teacher={l.teacher}
              teacherId={l.teacher_id}
              teacherHref={teacherHref(l.teacher_id)}
              verifiedBy={l.verified_by}
              verifiedAt={l.verified_at}
            />
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .teacher {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 40px;
  }
  .teacher img {
    border-radius: 3px;
    flex: none;
  }
  h1 {
    font-weight: 800;
    font-size: clamp(30px, 5vw, 52px);
    line-height: 1;
    letter-spacing: -0.04em;
    overflow-wrap: anywhere;
  }
  .summary {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin: 10px 0 0;
    font-size: 15px;
    color: var(--muted);
  }
</style>
